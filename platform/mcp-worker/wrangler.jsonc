{
  // Hosted AAJ Engines MCP server (roadmap R6). Deploy from this folder:
  //   node build.mjs && npx wrangler deploy
  // It serves https://mcp.aajconsult.com/mcp (custom domain) and keeps
  // https://aaj-engines-mcp.<your-subdomain>.workers.dev/mcp on, so connectors
  // added with the old address keep working. The custom domain needs the zone
  // aajconsult.com on this Cloudflare account, no existing DNS record named
  // "mcp", and a deploy token with Zone > Workers Routes > Edit on that zone.
  "name": "aaj-engines-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "mcp.aajconsult.com", "custom_domain": true }],
  // Error lines only (no inputs). Per-request invocation logs are off so that
  // Cloudflare keeps no request metadata (headers, IP) for this server.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
